# KyberM0nk local environment template
# Copy to .env and fill local secrets. Never commit .env.

COMPOSE_PROJECT_NAME=kyberm0nk

# Guardian remains outside Docker.
# Linux Docker host gateway should resolve through extra_hosts in compose.
GUARDIAN_BASE_URL=http://host.docker.internal:11434/v1
GUARDIAN_API_KEY=replace-me

# Model aliases are resolved by Guardian.
DEFAULT_MODEL=qwen3-35b-reasoning-agent
FAST_MODEL=llama3
DEEP_MODEL=qwen3-35b-uncensored

# Local coding-agent defaults based on Guardian context benchmarks.
# Keep max output conservative; 32768-token long-decode requests repeatedly hit
# the 600s failure boundary on the current Qwen3.6/llama.cpp stack.
OPENCODE_CONTEXT_WINDOW=65536
OPENCODE_MAX_TOKENS=4096
OPENCODE_TEMPERATURE=0.2
OPENCODE_MAX_OUTPUT_CHARS=20000

# Active project mounted read-write by operator choice.
ACTIVE_PROJECT=/home/flip/cryptotrader

# Reference projects should be mounted read-only.
REFERENCE_PROJECTS=/home/flip/agent-forge:/refs/agent-forge:ro,/home/flip/caramba:/refs/caramba:ro,/home/flip/market-data:/refs/market-data:ro

# Optional Windows Unreal executor reachable from Agent Zero inside the sandbox.
# Keep the private key outside the repository; the provisioning script copies only this key into the sandbox.
WINDOWS_UNREAL_SSH_ALIAS=unreal-windows
WINDOWS_UNREAL_SSH_HOST=192.168.1.245
WINDOWS_UNREAL_SSH_USER=onyou
WINDOWS_UNREAL_SSH_KEY_PATH=/home/flip/.ssh/kyberm0nk_windows_unreal_ed25519

# Safety defaults.
ALLOW_DOCKER_SOCKET=false
DEBUG=1
