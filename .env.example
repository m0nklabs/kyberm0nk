# KyberM0nk local environment template
# Copy to .env and fill local secrets. Never commit .env.

# Optional legacy compose name for one-off container experiments.
COMPOSE_PROJECT_NAME=kyberm0nk

# Guardian remains outside Kyber and is reached directly from host-native tools.
GUARDIAN_BASE_URL=http://127.0.0.1:11434/v1
KYBERM0NK_GUARDIAN_API_KEY=replace-me
AIDER_GUARDIAN_API_KEY=replace-me
OPENCODE_GUARDIAN_API_KEY=replace-me
CREWAI_GUARDIAN_API_KEY=replace-me
AGENT_ZERO_GUARDIAN_API_KEY=replace-me

# Model aliases are resolved by Guardian.
DEFAULT_MODEL=qwen3-35b-reasoning-agent
FAST_MODEL=llama3
DEEP_MODEL=qwen3-35b-uncensored

# Local coding-agent defaults based on Guardian context benchmarks.
# Keep max output conservative; 32768-token long-decode requests repeatedly hit
# the 600s failure boundary on the current Qwen3.6/llama.cpp stack.
OPENCODE_CONTEXT_WINDOW=65536
OPENCODE_MAX_TOKENS=4096
OPENCODE_TEMPERATURE=0.2
OPENCODE_MAX_OUTPUT_CHARS=20000

# Host-native OpenCode worker runtime root. The bootstrap keeps OpenCode here
# and exposes stable worker entrypoints in `bin/`.
KYBER_WORKERS_VENV_DIR=/home/flip/venvs/kyber-workers

# Host-native Aider runtime.
AIDER_ROOT=/home/flip/aider

# Host-native Superset cockpit.
SUPERSET_ROOT=/home/flip/superset
SUPERSET_HOME_DIR=/home/flip/.superset

# Direct CrewAI main quest manager.
CREWAI_VENV_DIR=/home/flip/crewai
CREWAI_PROJECT_PATH=/home/flip/NewNexus
CREWAI_GUARDIAN_API_BASE=http://127.0.0.1:11434/v1
OPENROUTER_API_KEY_FILE=/home/flip/.secrets/openrouter.key
OPENROUTER_API_KEY=
GITHUB_TOKEN_FILE=/home/flip/.secrets/kyberm0nk_github_token
GITHUB_TOKEN=

# Host-native Agent Zero runtime.
AGENT_ZERO_ROOT=/home/flip/agentzero
AGENT_ZERO_UI_PORT=50001

# Active project selected by operator choice.
ACTIVE_PROJECT=/home/flip/cryptotrader

# Reference projects should stay read-only by convention when used for lookup.
REFERENCE_PROJECTS=/home/flip/agent-forge:/refs/agent-forge:ro,/home/flip/caramba:/refs/caramba:ro,/home/flip/cryptotrader/related-repos/market-data:/refs/market-data:ro

# Optional Windows Unreal executor reachable from the host-native Agent Zero runtime.
# Keep the private key outside the repository; the provisioning script copies only this key into the isolated runtime secrets directory.
WINDOWS_UNREAL_SSH_ALIAS=unreal-windows
WINDOWS_UNREAL_SSH_HOST=192.168.1.245
WINDOWS_UNREAL_SSH_USER=ue_agent
WINDOWS_UNREAL_SSH_KEY_PATH=/home/flip/.ssh/kyberm0nk_windows_unreal_ed25519

# Safety defaults.
ALLOW_DOCKER_SOCKET=false
DEBUG=1
