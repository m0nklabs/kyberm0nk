# KyberM0nk local environment template
# Copy to .env and fill local secrets. Never commit .env.

# Optional legacy compose name for one-off container experiments.
COMPOSE_PROJECT_NAME=kyberm0nk

# Guardian remains outside Kyber and is reached directly from host-native tools.
GUARDIAN_BASE_URL=http://127.0.0.1:11434/v1
KYBERM0NK_GUARDIAN_API_KEY=replace-me
AIDER_GUARDIAN_API_KEY=replace-me
OPENCODE_GUARDIAN_API_KEY=replace-me
CREWAI_GUARDIAN_API_KEY=replace-me
AGENT_ZERO_GUARDIAN_API_KEY=replace-me

# Model aliases are resolved by Guardian.
DEFAULT_MODEL=qwen3-35b-reasoning-agent
FAST_MODEL=llama3
DEEP_MODEL=qwen3-35b-uncensored

# Hermes issue decomposition model for Master Epics via Guardian.
# Resolution order: HERMES_ISSUE_DECOMPOSE_MODEL -> DEFAULT_MODEL -> qwen3-35b-uncensored
HERMES_ISSUE_DECOMPOSE_MODEL=

# Read-only Hermes queue watchdog thresholds used by scripts/hermes_queue_watchdog.py.
# The watchdog reports stale rows and pressure signals; it does not mutate the queue.
HERMES_ISSUE_DB=/home/flip/.hermes/issue_resolution.db
HERMES_QUEUE_STALE_RUNNING_SECONDS=7200
HERMES_QUEUE_STALE_QUEUED_SECONDS=3600
HERMES_QUEUE_DEPTH_THRESHOLD=5
HERMES_QUEUE_FAILED_RECENT_SECONDS=86400
HERMES_QUEUE_FAILED_THRESHOLD=3

# Local coding-agent defaults based on Guardian context benchmarks.
# Keep max output conservative; 32768-token long-decode requests repeatedly hit
# the 600s failure boundary on the current Qwen3.6/llama.cpp stack.
OPENCODE_CONTEXT_WINDOW=65536
OPENCODE_MAX_TOKENS=4096
OPENCODE_TEMPERATURE=0.2
OPENCODE_MAX_OUTPUT_CHARS=20000

# Host-native OpenCode worker runtime root. The bootstrap keeps OpenCode here
# and exposes stable worker entrypoints in `bin/`.
KYBER_WORKERS_VENV_DIR=/home/flip/venvs/kyber-workers

# Host-native Aider runtime.
AIDER_ROOT=/home/flip/aider

# Daily OpenRouter advisor lane for hard questions.
AIDER_ADVISOR_MODEL=openrouter/openai/gpt-5.5
AIDER_ADVISOR_STATE_DIR=/home/flip/.local/state/kyberm0nk

# Host-native Superset cockpit.
SUPERSET_ROOT=/home/flip/superset
SUPERSET_HOME_DIR=/home/flip/.superset

# Direct CrewAI main quest manager.
CREWAI_VENV_DIR=/home/flip/crewai
CREWAI_PROJECT_PATH=/home/flip/NewNexus
CREWAI_GUARDIAN_API_BASE=http://127.0.0.1:11434/v1
OPENROUTER_API_KEY_FILE=/home/flip/.secrets/openrouter.key
OPENROUTER_API_KEY=

# Required for the Hermes /issue lane (webhook, CLI, and Master Epic sub-issue creation).
# GITHUB_TOKEN_FILE takes precedence over GITHUB_TOKEN when wrappers support both.
GITHUB_TOKEN_FILE=/home/flip/.secrets/kyberm0nk_github_token
GITHUB_TOKEN=

# Host-native Agent Zero runtime.
AGENT_ZERO_ROOT=/home/flip/agentzero
AGENT_ZERO_UI_PORT=50001

# Active project selected by operator choice.
ACTIVE_PROJECT=/home/flip/cryptotrader

# Reference projects should stay read-only by convention when used for lookup.
REFERENCE_PROJECTS=/home/flip/agent-forge:/refs/agent-forge:ro,/home/flip/caramba:/refs/caramba:ro,/home/flip/cryptotrader/related-repos/market-data:/refs/market-data:ro

# Optional Windows Unreal executor reachable from the host-native Agent Zero runtime.
# Keep the private key outside the repository; the provisioning script copies only this key into the isolated runtime secrets directory.
WINDOWS_UNREAL_SSH_ALIAS=unreal-windows
WINDOWS_UNREAL_SSH_HOST=192.168.1.245
WINDOWS_UNREAL_SSH_USER=ue_agent
WINDOWS_UNREAL_SSH_KEY_PATH=/home/flip/.ssh/kyberm0nk_windows_unreal_ed25519

# --- Aider Review Loop (cryptotrader_pr_aider_reviewer_loop.py) ---
# All AIDER_REVIEW_* vars control the autonomous PR reviewer behaviour.
# They are consumed by: ~/.hermes/scripts/cryptotrader_pr_aider_reviewer_loop.py

# Which OpenRouter model to use for Tier1 (first-pass) review.
# AIDER_REVIEW_MODEL=openrouter/deepseek/deepseek-v4-flash

# Which OpenRouter model to use for Tier2 (adversarial confirmation) review.
# AIDER_REVIEW_TIER2_MODEL=openrouter/deepseek/deepseek-v4-pro

# Extra CLI arguments passed only to the Tier2 aider invocation.
# AIDER_REVIEW_TIER2_EXTRA_ARGS=

# Fallback model when the primary model is unavailable (e.g. rate-limited).
# AIDER_REVIEW_FALLBACK_MODEL=openrouter/deepseek/deepseek-v3.2

# Force review of a specific PR number (0 = scan all open PRs).
# AIDER_REVIEW_TARGET_PR=0

# If true, ignore existing review comments and re-review even when
# a prior non-Copilot review exists on the same SHA.
# AIDER_REVIEW_IGNORE_EXISTING_REVIEWS=false

# If true, skip posting review comments to GitHub (for testing output quality).
# AIDER_REVIEW_DRY_RUN=false

# If true, force review even when a PR has pending suggestions from a prior run.
# AIDER_REVIEW_FORCE_WITH_PENDING=false

# If true, force re-review even when the head SHA matches the last reviewed SHA.
# AIDER_REVIEW_FORCE_REREVIEW_SAME_SHA=false

# If true, allow posting a review even if a duplicate (same SHA + tier + summary
# fingerprint) was already posted. Keep false to preserve prompt-cache friendliness
# and avoid duplicate OpenRouter spend under retry/parallel load.
# AIDER_REVIEW_ALLOW_DUPLICATE_REPOST=false

# Time window (minutes) for duplicate review detection.
# AIDER_REVIEW_DUPLICATE_WINDOW_MINUTES=30

# Max characters of the PR diff to pass to the reviewer model.
# Larger PRs are trimmed: 14KB per source file, 3.5KB per test file.
# Lower this before increasing reviewer model strength when TPM pressure is high.
# AIDER_REVIEW_MAX_DIFF_CHARS=35000

# Max open PRs to scan per loop invocation. Keep bounded so a retry storm or large
# backlog does not fan out across too many OpenRouter calls at once.
# AIDER_REVIEW_MAX_OPEN_PRS=40

# Max inline comments (file-line level) to post per review.
# AIDER_REVIEW_MAX_INLINE_COMMENTS=5

# Conservative OpenRouter resilience knobs for Hermes-managed review scripts that
# support them. These keep retries bounded and decorrelated without changing auth
# or the selected OpenRouter route.
# AIDER_REVIEW_MAX_RETRIES=2
# AIDER_REVIEW_RETRY_BASE_SECONDS=5
# AIDER_REVIEW_RETRY_MAX_SECONDS=120
# AIDER_REVIEW_RETRY_JITTER_RATIO=0.5
# AIDER_REVIEW_PARALLELISM=1
# AIDER_REVIEW_RATE_LIMIT_COOLDOWN_SECONDS=60

# Safety defaults.
ALLOW_DOCKER_SOCKET=false
DEBUG=1
