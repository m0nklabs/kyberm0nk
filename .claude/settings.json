{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": "PROJECT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd); python3 \"$PROJECT_ROOT/.claude/statusline.py\"",
    "padding": 1,
    "refreshInterval": 3
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block_large_mentions.py",
            "args": [],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_large_read.py",
            "args": [],
            "timeout": 5
          }
        ]
      }
    ]
  }
}