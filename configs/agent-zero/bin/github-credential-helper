#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" != "get" ]]; then
  exit 0
fi

protocol=""
host=""
while IFS='=' read -r key value; do
  [[ -n "${key}" ]] || break
  case "${key}" in
    protocol) protocol="${value}" ;;
    host) host="${value}" ;;
  esac
done

if [[ "${protocol}" != "https" || "${host}" != "github.com" ]]; then
  exit 0
fi

token_file="${KYBERM0NK_GITHUB_TOKEN_FILE:-/run/kyberm0nk/secrets/github_token}"
if [[ ! -r "${token_file}" ]]; then
  exit 0
fi

token=""
IFS= read -r token < "${token_file}" || true
if [[ -z "${token}" ]]; then
  exit 0
fi

printf 'username=x-access-token\n'
printf 'password=%s\n' "${token}"