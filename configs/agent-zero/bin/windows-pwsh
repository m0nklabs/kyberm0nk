#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' \
  "DEPRECATED: windows-pwsh is no longer a supported Windows command wrapper." \
  "" \
  "Why: this wrapper made local agents depend on Kyber shortcuts instead of generating real commands." \
  "Workers must generate the direct PowerShell or Windows command needed for the task." \
  "" \
  "Use instead:" \
  "  ssh unreal-windows \"powershell -NoProfile -ExecutionPolicy Bypass -Command \\\"<your PowerShell command>\\\"\"" \
  "" \
  "Keep source edits in /home/flip/NewNexus. Use Windows only for Git sync, Unreal builds, editor launches, and validation." \
  "If quoting fails, report the exact command and output instead of retrying random variants." >&2

exit 2