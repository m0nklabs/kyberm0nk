set -euo pipefail

printf '%s\n' \
  "DEPRECATED: newnexus-windows-build is no longer a supported NewNexus validation command." \
  "" \
  "Why: this wrapper hid the real Windows/Git/Unreal command flow and confused local agents." \
  "Workers must generate the direct command needed for the current task." \
  "" \
  "Use instead:" \
  "  1. Work in /a0/usr/projects/newnexus inside the sandbox." \
  "  2. Commit/push from the sandbox when validation needs the Windows checkout." \
  "  3. Run direct Windows commands through ssh unreal-windows." \
  "" \
  "Examples to adapt, not copy blindly:" \
  "  ssh unreal-windows \"powershell -NoProfile -ExecutionPolicy Bypass -Command \\\"Set-Location 'J:\\Unreal Projects\\NewNexus'; git pull --ff-only\\\"\"" \
  "  ssh unreal-windows \"powershell -NoProfile -ExecutionPolicy Bypass -Command \\\"& 'J:\\UNREAL_ENGINE\\UE_5.7\\Engine\\Binaries\\DotNET\\UnrealBuildTool\\UnrealBuildTool.exe' NewNexusEditor Win64 Development -Project='J:\\Unreal Projects\\NewNexus\\NewNexus.uproject'\\\"\"" \
  "" \
  "If quoting fails, report the exact command and output instead of retrying random variants." >&2

