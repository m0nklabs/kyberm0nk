  "" \
  "Known NewNexus paths:" \
  "  Project: J:\\Unreal Projects\\NewNexus" \
  "  Engine:  J:\\UNREAL_ENGINE\\UE_5.7" \
  "  UBT:     J:\\UNREAL_ENGINE\\UE_5.7\\Engine\\Binaries\\DotNET\\UnrealBuildTool\\UnrealBuildTool.exe" >&2

