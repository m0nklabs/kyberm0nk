{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m0nklabs.github.io/kyberm0nk/docs/kyber-tag.jsonschema",
  "title": "Kyber PR Routing Tag",
  "description": "Machine-readable routing tag embedded in PR review comments by the automated reviewer loop. The tag is serialized as a [pr-manager] JSON block in the review body.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "next_action",
    "state",
    "source",
    "tier",
    "model",
    "suggestions_count",
    "content_fingerprint"
  ],
  "properties": {
    "content_fingerprint": {
      "type": "string",
      "description": "Lowercase SHA-256 hex digest prefix (first 16 chars, 64 bits) of the review summary + inline comment bodies. Used for duplicate detection, not for security decisions.",
      "minLength": 16,
      "maxLength": 16,
      "pattern": "^[0-9a-f]{16}$"
    },
    "source": {
      "type": "string",
      "description": "Identity of the review tool that produced the tag.",
      "minLength": 1
    },
    "pr": {
      "type": "integer",
      "description": "GitHub PR number that the tag applies to."
    },
    "tier": {
      "type": "string",
      "enum": ["tier1", "tier2", "tier3"],
      "description": "Review tier that produced the tag."
    },
    "model": {
      "type": "string",
      "description": "Full model identifier used (e.g. openrouter/deepseek/deepseek-v4-flash).",
      "minLength": 1
    },
    "next_action": {
      "type": "string",
      "enum": [
        "coding_subagent",
        "ready_for_merge",
        "tier1_review",
        "tier2_review",
        "tier3_review",
        "rerun_reviewer"
      ],
      "description": "Routing instruction: what should happen next in the PR lifecycle."
    },
    "suggestions_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Actionable internal plus Copilot/code-quality suggestion count observed by the reviewer pass."
    },
    "state": {
      "type": "string",
      "enum": [
        "review_findings",
        "ready_for_merge",
        "review_inconclusive"
      ],
      "description": "Outcome state of this review pass."
    }
  },
  "examples": [
    {
      "content_fingerprint": "a1b2c3d4e5f60708",
      "source": "aider-reviewer",
      "pr": 309,
      "tier": "tier1",
      "model": "openrouter/deepseek/deepseek-v4-flash",
      "suggestions_count": 2,
      "next_action": "coding_subagent",
      "state": "review_findings"
    },
    {
      "content_fingerprint": "09a1b2c3d4e5f678",
      "source": "aider-reviewer",
      "pr": 309,
      "tier": "tier2",
      "model": "openai/gemma4-26b-a4b",
      "suggestions_count": 0,
      "next_action": "ready_for_merge",
      "state": "ready_for_merge"
    }
  ]
}
